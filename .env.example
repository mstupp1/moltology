# Database connection (Neon PostgreSQL Pooled / Direct URLs)
DATABASE_URL="postgresql://user:password@ep-sample-dev.region.aws.neon.tech/neondb?sslmode=require"
DEV_DATABASE_URL="postgresql://user:password@ep-sample-dev.region.aws.neon.tech/neondb?sslmode=require"
PROD_DATABASE_URL="postgresql://user:password@ep-sample-prod.region.aws.neon.tech/neondb?sslmode=require"

# Self-hosted Better Auth (do not set VITE_NEON_AUTH_URL / neonauth host)
BETTER_AUTH_SECRET="generate-a-32-plus-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated extras (Vercel preview + moltology.org are added automatically)
# BETTER_AUTH_TRUSTED_ORIGINS="https://your-preview.vercel.app"

# Google OAuth — optional. Email/password works without these.
# Server: GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET (never exposed to the browser).
# Client button: only VITE_GOOGLE_AUTH_ENABLED=true|1. Vite bakes that flag to
# true at build/dev when both server secrets exist, unless you set it yourself.
# Google Cloud Console setup for local dev:
#   - Authorized JavaScript origins: http://localhost:3000
#   - Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# VITE_GOOGLE_AUTH_ENABLED="true"

# Neon S3-Compatible Object Storage
AWS_ENDPOINT_URL_S3="https://your-branch.storage.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_your_key_id"
AWS_SECRET_ACCESS_KEY="nsk_live_your_secret_key"
AWS_REGION="us-east-2"
AWS_S3_BUCKET="moltology-public-assets"

# Vercel AI Gateway (used when passing string model IDs like "openai/gpt-5.6-luna")
AI_GATEWAY_API_KEY="your_ai_gateway_api_key"

# Cloudflare Turnstile Bot Protection (Managed / Invisible Challenge)
# Default test keys (Always Pass): Site=1x00000000000000000000AA, Secret=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Fish Audio S2 TTS (primary voiceover for reel/series pipelines; Edge TTS is fallback)
FISH_API_KEY=""
FISH_VOICE_REFERENCE_ID=""   # preset library voice id (see npm run tts:voices)
FISH_TTS_MODEL="s2.1-pro"    # or s2.1-pro-free for dev/prototyping
TTS_PROVIDER="auto"            # auto | fish | edge

# Zernio API (automated social queueing for Instagram and YouTube)
ZERNIO_API_KEY=""

# Stripe Premium (test mode until go-live). Never commit real keys.
# Prefer a restricted key (rk_ prefix) in STRIPE_SECRET_KEY over a secret key (sk_ prefix).
# Checkout charges whatever Price this id points at. Do not hardcode the amount in app code.
# Required for checkout and the customer portal: STRIPE_SECRET_KEY, STRIPE_PREMIUM_PRICE_ID
# Required for webhooks: STRIPE_WEBHOOK_SECRET
# Webhook endpoint: /api/stripe/webhook
# Listen for checkout.session.completed, customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, and invoice.payment_failed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""
# STRIPE_PREMIUM_PRODUCT_ID=""
# Hosted Checkout does not need a publishable key. Optional for a future embedded form:
# VITE_STRIPE_PUBLISHABLE_KEY=""

