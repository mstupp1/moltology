# Local configuration: copy this template to .env and fill in your values.
# App and CLI scripts use .env; many scripts load it with dotenv/config.
# Keep each variable once. Values beginning with VITE_ are public browser config.
# Blank credentials leave that integration unconfigured.

# DATABASE — local app uses DATABASE_URL; point it at Neon dev.
# DEV_DATABASE_URL is an explicit target / safety check for admin scripts.
# PROD_DATABASE_URL is only needed locally for production admin / ingest work.
# DATABASE_URL and DEV_DATABASE_URL should normally point at the same dev branch.
DATABASE_URL=""
DEV_DATABASE_URL=""
# PROD_DATABASE_URL=""

# AUTH — self-hosted Better Auth (no Neon managed-auth endpoint / JWKS needed).
# Use a random secret of at least 32 characters.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Extra comma-separated origins; localhost, moltology.org and Vercel preview are added automatically.
# BETTER_AUTH_TRUSTED_ORIGINS=""

# GOOGLE SIGN-IN — optional; email/password does not need these.
# Local OAuth origin: http://localhost:3000
# Local OAuth redirect: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Vite enables the Google button when both server credentials exist.
# VITE_GOOGLE_AUTH_ENABLED="true"

# EMAIL — Resend for verification, support and transactional messages.
RESEND_API_KEY=""
# Use a sender on your verified Resend domain; unset uses the app default.
# RESEND_FROM_EMAIL="Moltology <sender@your-verified-domain>"

# BOT PROTECTION — these are public Cloudflare always-pass test keys for local dev.
# Use your real site / secret pair on deployed environments.
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# OBJECT STORAGE — Neon S3-compatible website / reusable assets.
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
AWS_S3_BUCKET="moltology-public-assets"

# AI — Gateway for app AI / signup screening; Gemini for content tooling.
# Signup screening uses the Gateway key; no separate TYPESAFE_API_KEY.
AI_GATEWAY_API_KEY=""
GEMINI_API_KEY=""
# Image / video scripts accept VERTEX_API_KEY as a fallback; prefer GEMINI_API_KEY.
# Other Gemini tools do not read VERTEX_API_KEY. No need to set both.
# Optional moderation override (default: convaiinnovations/laya).
# MODERATION_MODEL_ID=""

# VOICEOVERS — optional Fish Audio; auto mode falls back to Edge TTS.
FISH_API_KEY=""
# Defaults shown; uncomment only to override.
# FISH_TTS_MODEL="s2.1-pro"
# TTS_PROVIDER="auto"
# Optional fixed Fish voice; otherwise the script / voice catalog selects one.
# FISH_VOICE_REFERENCE_ID=""

# SOCIAL — Zernio queueing for Instagram / YouTube.
ZERNIO_API_KEY=""
# Google Drive desktop archive; auto-detected on a Mac with one Drive account.
# SOCIAL_ARCHIVE_ROOT="/absolute/path/to/My Drive/Projects/Moltology"

# PAYMENTS — Stripe shared by Premium and merch; use test credentials locally.
# Prefer a restricted rk_ key with the permissions your workflows need.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Premium checkout charges this Price; no hardcoded subscription amount.
STRIPE_PREMIUM_PRICE_ID=""
# Optional product-match validation; keep it if you want that check.
# STRIPE_PREMIUM_PRODUCT_ID=""
# Webhook endpoint: /api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_failed. See docs/merch-launch.md for merch / refund setup.
# Hosted Checkout does not need a publishable key.

# MERCH — needed when using the Printful store integration.
PRINTFUL_API_TOKEN=""
# Required for app shipping quotes and webhook store checks, even for one store.
# Select the Manual order platform/API store matching the approved catalog.
PRINTFUL_STORE_ID=""
# Keep drafts explicit. Test payments and preview deployments always stay drafts.
PRINTFUL_DRAFT="true"
# Enable only when Stripe Tax is configured; unset defaults to off.
# STRIPE_AUTOMATIC_TAX="true"
# Current checkout uses live Printful shipping quotes, not MERCH_SHIPPING_CENTS.

# STORE OPERATIONS — configure when testing the full merch flow.
# Keep launch controls false locally; enabling production is a separate decision.
STORE_PUBLIC_LAUNCH_AUTHORIZED="false"
STORE_LIVE_PAYMENTS_AUTHORIZED="false"
# Independent random secrets, each at least 32 characters; server-only.
STORE_STATUS_SECRET=""
STORE_RECOVERY_SECRET=""
PRINTFUL_WEBHOOK_SECRET=""
STORE_SUPPORT_INBOX=""
# Printful callback: https://<deployment>/api/printful/webhook?key=<PRINTFUL_WEBHOOK_SECRET>
# Recovery automation uses STORE_RECOVERY_URL in GitHub Actions, with a matching secret.

# OPTIONAL LOCAL TOOLS — usually leave unset.
# Merch dev safety check can use this instead of DEV_DATABASE_URL.
# NEON_DEV_ENDPOINT_ID="ep-your-dev-endpoint"
# Stripe listener also finds tmp/merch/tools/stripe.
# STRIPE_CLI_PATH="/absolute/path/to/stripe"
# Local catalog preview with checkout disabled; do not set in Vercel.
# VITE_MERCH_PREVIEW="1"

# Marketing Contacts: RESEND_API_KEY needs Full access (Sending access cannot manage Contacts).
# Create these three Resend segments (not Topics).
RESEND_LEADS_SEGMENT_ID=""
RESEND_USERS_SEGMENT_ID=""
RESEND_ALL_SUBSCRIBERS_SEGMENT_ID=""
# Signing secret for contact.updated events at /api/email/webhook.
RESEND_WEBHOOK_SECRET=""
