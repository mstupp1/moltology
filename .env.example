# Database connection (Neon PostgreSQL Pooled / Direct URLs)
DATABASE_URL="postgresql://user:password@ep-sample-dev.region.aws.neon.tech/neondb?sslmode=require"
DEV_DATABASE_URL="postgresql://user:password@ep-sample-dev.region.aws.neon.tech/neondb?sslmode=require"
PROD_DATABASE_URL="postgresql://user:password@ep-sample-prod.region.aws.neon.tech/neondb?sslmode=require"

# Neon Auth Managed Endpoints
VITE_NEON_AUTH_URL="https://your-project.neonauth.region.aws.neon.tech/neondb/auth"
VITE_NEON_JWKS_URL="https://your-project.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Neon S3-Compatible Object Storage
AWS_ENDPOINT_URL_S3="https://your-branch.storage.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_your_key_id"
AWS_SECRET_ACCESS_KEY="nsk_live_your_secret_key"
AWS_REGION="us-east-2"
AWS_S3_BUCKET="moltology-public-assets"

# Vercel AI Gateway (used when passing string model IDs like "openai/gpt-5.6-luna")
AI_GATEWAY_API_KEY="your_ai_gateway_api_key"

# Cloudflare Turnstile Bot Protection (Managed / Invisible Challenge)
# Default test keys (Always Pass): Site=1x00000000000000000000AA, Secret=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Fish Audio S2 TTS (primary voiceover for reel/series pipelines; Edge TTS is fallback)
FISH_API_KEY=""
FISH_VOICE_REFERENCE_ID=""   # preset library voice id (see npm run tts:voices)
FISH_TTS_MODEL="s2.1-pro"    # or s2.1-pro-free for dev/prototyping
TTS_PROVIDER="auto"            # auto | fish | edge

