{
  "name": "moltology",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run src/lib src/db",
    "test:ui": "vitest run src/components src/routes src/hooks",
    "test:scripts": "vitest run scripts/",
    "test:changed": "vitest run --changed",
    "test:file": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:rls": "tsx src/db/enable-rls.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:grant-admin": "tsx src/db/grant-admin.ts",
    "db:ingest": "tsx scripts/ingest.ts",
    "s3:upload": "tsx scripts/upload-asset.ts",
    "s3:sync": "tsx scripts/sync-s3-assets.ts",
    "s3:verify": "tsx scripts/sync-s3-assets.ts --verify",
    "assets:check": "tsx scripts/check-asset-budget.ts",
    "video:generate": "tsx scripts/generate-video.ts",
    "reel:create": "tsx scripts/create-daily-reel.ts",
    "shorts:create": "tsx scripts/create-daily-reel.ts",
    "video:create": "tsx scripts/create-daily-reel.ts",
    "series:create": "tsx scripts/create-viral-series-reel.ts",
    "series:prompt": "tsx scripts/create-viral-series-reel.ts --prompt-only",
    "db:setup": "npm run db:migrate && npm run db:rls && npm run db:seed",
    "db:reset": "tsx src/db/reset.ts && npm run db:setup",
    "codex:sync": "tsx scripts/sync-codex.ts",
    "codex:check": "tsx scripts/sync-codex.ts --check",
    "mockups:capture": "tsx scripts/capture-dashboard-mockups.ts",
    "composite:render": "tsx scripts/render-composite.ts",
    "composite:capture": "tsx scripts/render-composite.ts",
    "post:create": "tsx scripts/create-instagram-post.ts",
    "carousel:create": "tsx scripts/create-instagram-carousel.ts",
    "guide:pdf": "tsx scripts/generate-guide-pdf.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.27",
    "@ai-sdk/react": "^4.0.51",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@daveyplate/better-auth-ui": "^3.4.0",
    "@dicebear/core": "^10.6.1",
    "@dicebear/styles": "^10.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/neon-js": "^0.6.2-beta",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slider": "^1.4.7",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "ai": "^7.0.48",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.474.0",
    "marked": "^18.0.11",
    "nitro": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.4",
    "jsdom": "^30.0.1",
    "msedge-tts": "^2.0.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
