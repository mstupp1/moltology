{
  "framework": "tanstack-start",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "redirects": [
    {
      "source": "/alignment",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/premium",
      "destination": "/max",
      "permanent": true
    },
    {
      "source": "/watch",
      "destination": "/admin?tab=watch",
      "permanent": true
    },
    {
      "source": "/admin/store",
      "destination": "/admin?tab=store",
      "permanent": true
    },
    {
      "source": "/chassis",
      "destination": "/character",
      "permanent": true
    },
    {
      "source": "/pipeline",
      "destination": "/character/progress",
      "permanent": true
    },
    {
      "source": "/lectures",
      "destination": "/academy",
      "permanent": true
    },
    {
      "source": "/lectures/:path*",
      "destination": "/academy/:path*",
      "permanent": true
    },
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/stream",
      "destination": "/profile?tab=activity",
      "permanent": true
    },
    {
      "source": "/stages",
      "destination": "/character/progress",
      "permanent": true
    },
    {
      "source": "/connections",
      "has": [{ "type": "query", "key": "tab" }],
      "destination": "/profile",
      "permanent": true
    },
    {
      "source": "/connections",
      "destination": "/profile?tab=friends",
      "permanent": true
    },
    {
      "source": "/friends",
      "has": [{ "type": "query", "key": "tab" }],
      "destination": "/profile",
      "permanent": true
    },
    {
      "source": "/friends",
      "destination": "/profile?tab=friends",
      "permanent": true
    },
    {
      "source": "/market",
      "destination": "/character/shop",
      "permanent": true
    },
    {
      "source": "/what-is-moltology/what-moltologists-say",
      "destination": "/what-is-moltology#voices",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/media/:path*",
      "destination": "https://br-bitter-dew-ayea5tmh.storage.c-5.us-east-2.aws.neon.tech/moltology-public-assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/store/status",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
